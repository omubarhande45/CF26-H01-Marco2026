# Copy to .env and replace placeholders. Never commit real secrets.

FCQF_ENV=development
JWT_SECRET=replace-with-long-random-string
JWT_ALG=HS256
AUTH_PROVIDER=local
ALLOW_DEMO_USERS=1

USER_RESEARCHER_PASSWORD=research123
USER_AUDITOR_PASSWORD=audit123
USER_ADMIN_PASSWORD=admin123

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

SERVICE_AUTH=token
SERVICE_TOKEN=
REQUIRE_SERVICE_AUTH=0

MIN_COHORT=10
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=1e-5
PRIVACY_BUDGET_PER_ACTOR=8.0
NODE_TIMEOUT=4.0
NODE_RETRIES=2

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

NODE_A=http://127.0.0.1:8101
NODE_B=http://127.0.0.1:8102
NODE_L=http://127.0.0.1:8103
