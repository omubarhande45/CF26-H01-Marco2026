GATEWAY_URL=http://127.0.0.1:8080

NODE_ID=hospital_a
NODE_NAME=Hospital A
DB_PATH=institutional_nodes/data/hospital_a.db
SCHEMA_VERSION=1.2
FORCE_OFFLINE=0
NODE_K=10
